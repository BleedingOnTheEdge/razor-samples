<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);NU1900;CS1591</NoWarn>

        <Version>1.0.0</Version>
        <Authors>BleedingOnTheEdge</Authors>
        <Company>BleedingOnTheEdge</Company>
        <Copyright>© 2026 BleedingOnTheEdge</Copyright>

        <!-- Sdk resolution when cloned in organization tree -->
        <RazorSdkPath Condition="Exists('$(MSBuildThisFileDirectory)../../razor-sdk/src/Sdk/Sdk.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../razor-sdk/src/Sdk/Sdk.csproj'))</RazorSdkPath>
    </PropertyGroup>
</Project>
